<header class="site-header">
  <div class="site-header__inner">
    <% if current_user %>
      <%= link_to t("app.name"), root_path, class: "site-header__brand" %>

      <nav class="site-header__navigation" aria-label="メインナビゲーション">
        <%= link_to t("layouts.header.today"), root_path, class: "site-header__nav-link" %>
        <%= link_to t("layouts.header.tasks"), tasks_path, class: "site-header__nav-link" %>
        <%= link_to t("layouts.header.history"), history_path, class: "site-header__nav-link" %>
        <%= button_to t("home.logout"), logout_path, method: :delete, class: "site-header__logout" %>
      </nav>
    <% else %>
      <span class="site-header__brand"><%= t("app.name") %></span>
    <% end %>
  </div>
</header>