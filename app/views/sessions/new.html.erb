<% content_for :title, t("sessions.new.title") %>

<main class="login-page">
  <section class="login-panel" aria-labelledby="login-title">
    <p class="login-panel__eyebrow"><%= t("app.name") %></p>
    <h1 id="login-title"><%= t("sessions.new.title") %></h1>

    <% if flash[:alert].present? %>
      <p class="registration-errors" role="alert"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: login_path, class: "registration-form" do |form| %>
      <div class="registration-form__field">
        <%= form.label :email, t("activerecord.attributes.user.email") %>
        <%= form.email_field :email, required: true, autocomplete: "email", placeholder: t("sessions.new.email_placeholder"), class: "form-control" %>
      </div>

      <div class="registration-form__field">
        <%= form.label :password, t("activerecord.attributes.user.password") %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t("sessions.new.password_placeholder"), class: "form-control" %>
      </div>

      <%= form.submit t("sessions.new.submit"), class: "registration-submit" %>
    <% end %>

    <div class="login-panel__signup">
      <p><%= t("sessions.new.signup_prompt") %></p>
      <%= link_to t("sessions.new.signup_link"), new_user_path, class: "login-panel__signup-link" %>
    </div>
  </section>
</main>