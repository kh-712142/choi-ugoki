<% content_for :title, t("app.name") %>

<main class="home-page">
  <section class="home-page__intro" aria-labelledby="page-title">
    <p class="home-page__eyebrow"><%= t("home.eyebrow") %></p>
    <h1 id="page-title"><%= t("home.title") %></h1>
    <p class="home-page__description">
      <%= t("home.description") %>
    </p>
    <%= button_to t("home.logout"), logout_path, method: :delete, class: "home-page__logout" %>
  </section>
</main>